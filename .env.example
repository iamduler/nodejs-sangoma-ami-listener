# AMI Connection Settings
AMI_HOST=192.168.1.100
AMI_PORT=5038
AMI_USERNAME=admin
AMI_SECRET=secret123
AMI_RECONNECT_INTERVAL=5000
AMI_RECONNECT_MAX_ATTEMPTS=-1

# For api call. Like /click2call
API_TOKEN=

# Webhook Settings
WEBHOOK_URL=https://your-crm.com/api/webhooks/ami
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INITIAL_DELAY=1000
WEBHOOK_RETRY_MAX_DELAY=30000
WEBHOOK_RETRY_MULTIPLIER=2

# HTTP Server Settings (for health checks)
SERVER_ENABLED=true
SERVER_PORT=3000

# Logging
LOG_LEVEL=info

# Log File Settings
LOG_FILE_ENABLED=true
LOG_FILE_DIRECTORY=./logs
LOG_RETENTION_DAYS=90
